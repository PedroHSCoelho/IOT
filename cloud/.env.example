# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o Git.
# Valores em: painel do Supabase > botão "Connect" > aba "Session pooler".
# ATENÇÃO: o host depende da região do projeto. O do projeto ponto-unifesp é us-east-1
# (e NÃO sa-east-1); copie sempre do painel.

# --- Administrador (usuário "postgres"): usado SÓ para rodar os scripts em db/ ---
# Usuário no pooler tem o formato: postgres.<ref-do-projeto>
ADMIN_DB_HOST=aws-0-us-east-1.pooler.supabase.com
ADMIN_DB_PORT=5432
ADMIN_DB_NAME=postgres
ADMIN_DB_USER=postgres.SEU_REF_DO_PROJETO
ADMIN_DB_PASSWORD=senha_do_banco_definida_na_criacao_do_projeto

# --- Node-RED (usuário "nodered", criado em db/init/04_usuarios.sql) ---
# A senha é definida UMA vez no SQL Editor: ALTER ROLE nodered WITH PASSWORD '...';
SUPABASE_DB_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=nodered.SEU_REF_DO_PROJETO
SUPABASE_DB_PASSWORD=senha_do_usuario_nodered

# --- Editor do Node-RED (usuário "admin") ---
# Hash bcrypt da senha do editor. Entre aspas simples (o hash tem "$").
# Como gerar: veja cloud/servidor/README.md. Sem este campo o Node-RED não inicia.
NODERED_ADMIN_HASH='cole_o_hash_bcrypt_aqui'

# Nunca coloque aqui as chaves anon/publishable/service_role do Supabase.
